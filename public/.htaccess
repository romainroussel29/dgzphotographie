# DGZ Photographie — configuration Apache pour l'hébergement mutualisé OVH.
# Ce fichier est copié tel quel à la racine du dossier out/ par `npm run build`.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# --- Forcer HTTPS ------------------------------------------------------------
# À activer une fois le certificat SSL actif dans l'espace client OVH
# (Hébergements > votre hébergement > Multisite > SSL) : retirer les « # » des 3 lignes suivantes.
# RewriteEngine On
# RewriteCond %{SERVER_PORT} 80
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# --- Types de fichiers -------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

# --- Cache navigateur et en-têtes de sécurité --------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Pages HTML : toujours revalidées, pour qu'une mise en ligne soit visible immédiatement.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Images de public/images : 30 jours, puis revalidation en arrière-plan.
  <FilesMatch "\.(webp|avif|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
  </FilesMatch>

  # JavaScript, CSS et polices générés par Next.js : leur nom change à chaque build, cache d'un an.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
