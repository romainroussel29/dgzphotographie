node_modules/

# Fichiers générés par Next.js
/site/.next/
/site/out/
/site/next-env.d.ts
*.tsbuildinfo

# Site compilé (npm run build) : à envoyer sur OVH, pas à versionner
/public/

# Images originales, lourdes : gardées en local, jamais mises en ligne
/img-originales/*
!/img-originales/.gitkeep

# Clés Supabase et autres secrets
.env*
!.env.example

*.log
*.pem
.DS_Store
